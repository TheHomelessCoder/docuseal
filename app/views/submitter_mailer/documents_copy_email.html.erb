<% if @body.present? %>
  <%= render 'custom_content', content: @body, submitter: @submitter, sig: @sig %>
<% else %>
  <%# Bennett Legal signed copy, in the signer's language. %>
  <% es = I18n.locale.to_s.start_with?('es') %>
  <% thanks = es ? 'Gracias por firmar. Su copia firmada está adjunta a este correo para sus archivos.' : 'Thank you for signing. Your signed copy is attached to this email for your records.' %>
  <% content_for :bennett_preview, thanks %>
  <%# One copy email can go to every signer, so greet without a name. %>
  <%= render 'bennett_paragraph', text: es ? 'Hola,' : 'Hello,' %>
  <%= render 'bennett_paragraph', text: thanks %>
  <%= render 'bennett_button', url: submissions_preview_url(@submitter.submission.slug, { sig: @sig, host: @custom_domain || ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host]) }.compact), label: es ? 'Ver mi copia firmada' : 'View my signed copy' %>
<% end %>
<%= render 'bennett_jud_context', context: @bennett_jud_context %>
<%= render 'bennett_closing' if @body.blank? %>
