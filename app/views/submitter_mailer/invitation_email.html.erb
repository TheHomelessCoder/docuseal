<% if @body.present? %>
  <%= render 'custom_content', content: @body, submitter: @submitter %>
  <% if !@body.match?(ReplaceEmailVariables::SUBMITTER_LINK) && !@body.match?(ReplaceEmailVariables::SUBMITTER_ID) && !@body.match?(ReplaceEmailVariables::SUBMISSION_LINK) && !@body.match?(ReplaceEmailVariables::TEMPLATE_ID) && !@submitter.submission.source.in?(%w[api embed]) %>
    <p><%= link_to nil, submit_form_url(slug: @submitter.slug, t: SubmissionEvents.build_tracking_param(@submitter, 'click_email'), host: @custom_domain || ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host])) %></p>
  <% end %>
<% else %>
  <%# Bennett Legal invitation, in the signer's language. %>
  <% es = I18n.locale.to_s.start_with?('es') %>
  <% sign_url = submit_form_url(slug: @submitter.slug, t: SubmissionEvents.build_tracking_param(@submitter, 'click_email'), host: @custom_domain || ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host])) %>
  <% with_code = @submitter.preferences['require_email_2fa'] || @submitter.submission.template&.preferences&.dig('require_email_2fa') %>
  <% ready = es ? 'Su contrato con Bennett Legal está listo. Revisarlo y firmarlo toma unos minutos desde su teléfono o computadora.' : 'Your retainer agreement with Bennett Legal is ready. It takes just a few minutes to review and sign on your phone or computer.' %>
  <% content_for :bennett_preview, ready %>
  <%= render 'bennett_paragraph', text: es ? "Hola #{@submitter.name}," : "Hello #{@submitter.name}," %>
  <%= render 'bennett_paragraph', text: ready %>
  <%= render 'bennett_button', url: sign_url, label: es ? 'Revisar y firmar' : 'Review and sign' %>
  <% if with_code %>
    <%= render 'bennett_paragraph', text: es ? 'Por su seguridad, al abrir el enlace le enviaremos un código de 6 dígitos a este correo.' : 'For your security, when you open the link we will email you a 6-digit code.' %>
  <% end %>
<% end %>
<% if @bennett_jud_context && @body.to_s.exclude?(@bennett_jud_context[:url]) %>
  <%= render 'bennett_jud_context', context: @bennett_jud_context %>
<% end %>
<%= render 'bennett_closing' unless @body.present? %>
