<%# The letterhead's call to action (nurture design.ts, button()): navy with a gold border,
    a white label and a gold arrow. The arrow stays out of the plain-text part. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 30px;">
  <tr>
    <td class="cta-surface" bgcolor="#001a2d" style="background-color:#001a2d;background-image:linear-gradient(#001a2d,#001a2d);border:1px solid #b18b35;">
      <a class="cta-link" href="<%= url %>" style="display:inline-block;padding:16px 23px;font:bold 13px/1.5 Arial,Helvetica,sans-serif;color:#ffffff;text-decoration:none;"><span class="gmail-screen" style="display:inline-block;"><span class="gmail-difference" style="display:inline-block;"><%= label %><!-- start text/html --> <span style="color:#d5b05b;">→</span><!-- end text/html --></span></span></a>
    </td>
  </tr>
</table>
