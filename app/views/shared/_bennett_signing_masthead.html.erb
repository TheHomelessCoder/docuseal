<div class="bennett-masthead">
  <div class="bennett-masthead__identity">
    <img class="bennett-masthead__logo" src="/packs/bennett-legal-logo-white.png" width="512" height="220" alt="Bennett Legal">
  </div>
  <div class="bennett-masthead__attribution">
    <span><%= t('powered_by') %></span>
    <a href="<%= Docuseal::PRODUCT_URL %>" class="bennett-masthead__vendor">
      <span><%= Docuseal.product_name %></span>
    </a>
  </div>
</div>
