<header class="bennett-staff-header">
  <a class="bennett-staff-skip" href="#staff-main">Skip to content</a>
  <div class="bennett-staff-topbar">
    <a class="bennett-staff-brand" href="https://jud.bennettlegal.com/retainers">
      <img src="/packs/bennett-legal-logo-white.png" width="512" height="220" alt="Bennett Legal">
      <span>Signing</span>
    </a>
    <nav class="bennett-staff-nav" aria-label="Signing workspace">
      <a href="https://jud.bennettlegal.com/retainers">JUD retainers</a>
      <% if bennett_staff_signed_in? %>
        <%= link_to 'All submissions', submissions_path, aria: { current: ('page' if bennett_staff_section == 'submissions' && params[:status] != 'completed') } %>
        <%= link_to 'Completed', submissions_path(status: 'completed'), aria: { current: ('page' if request.path == submissions_path && params[:status] == 'completed') } %>
        <%= link_to 'Templates', templates_path, aria: { current: ('page' if bennett_staff_section == 'templates') } %>
        <%= link_to 'Settings', settings_profile_index_path, aria: { current: ('page' if bennett_staff_section == 'settings') } %>
      <% end %>
    </nav>
    <details class="bennett-staff-account">
      <summary><span><%= bennett_staff_signed_in? ? (true_user.full_name.presence || true_user.email) : 'Appearance' %></span><span aria-hidden="true">⌄</span></summary>
      <div class="bennett-staff-account-menu">
      <label class="bennett-staff-appearance">Appearance
        <select data-staff-theme aria-label="Appearance">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <% if bennett_staff_signed_in? %>
        <%= button_to t('sign_out'), destroy_user_session_path, method: :delete, class: 'bennett-staff-signout', form: { data: { turbo: false } } %>
      <% end %>
      </div>
    </details>
  </div>
</header>
